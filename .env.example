# Copy this file to ".env" and fill in the real values.
#
# COPY it, do not rename it, because this template needs to stay behind. It is
# safe to commit because it holds no secrets. .env is gitignored and must never
# be committed.

# --- Groq (answer model and classifier) ---
# https://console.groq.com  ->  API Keys
# Keep the key here rather than in a Windows environment variable. A stale
# variable wins over this file and produces 401s from some shells and not
# others, which is confusing to diagnose.
GROQ_API_KEY=gsk_...

# --- Meta WhatsApp Cloud API (preferred transport) ---
# https://developers.facebook.com  ->  your app  ->  WhatsApp  ->  API Setup
# The full walkthrough is in docs/whatsapp-setup.md.
#
# The "Phone number ID" on that page, NOT the phone number. All digits.
WHATSAPP_PHONE_NUMBER_ID=
# API Setup page. The temporary token there EXPIRES IN 24 HOURS. For anything
# demoed on a fixed date, create a System User token instead
# (business.facebook.com -> Business Settings -> Users -> System Users) with
# whatsapp_business_messaging and whatsapp_business_management and no expiry.
WHATSAPP_ACCESS_TOKEN=
# App Settings -> Basic -> App Secret. Verifies inbound webhooks. Without it,
# anyone who finds the URL can spend the token budget.
WHATSAPP_APP_SECRET=
# Any long random string you invent. Paste the SAME value into the webhook form
# in the Meta dashboard. Meta echoes it back once to prove the URL is yours.
WHATSAPP_VERIFY_TOKEN=

# --- Twilio (fallback; unused whenever Meta is configured) ---
# https://console.twilio.com
# ACCOUNT_SID starts with "AC" and is on the console dashboard. A value starting
# with "SK" is an API Key SID, which is a different credential that will fail
# here. The Auth Token sits under the Account SID: 32 hex characters, no prefix.
#
# NOTE: a Twilio TRIAL account cannot send free-form WhatsApp text at all. It
# returns error 21654 and demands a pre-approved template, which a generated
# legal answer can never be. Meta's Cloud API is the working path.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Writable paths (optional) ---
# Default to sitting next to the code. On a hosted instance, point both at a
# mounted disk so the index and the case counter survive a restart.
# CHROMA_PATH=/var/data/chroma
# CASES_DB_PATH=/var/data/cases.db

# --- Demo behaviour ---
# Send the "one moment" message before the answer? Default on.
# Set to 0 while testing against a metered account, because it halves outbound
# volume. TURN IT BACK ON BEFORE THE DEMO. Without it, answers arrive after a
# silent twenty-second gap and the bot looks broken.
SEND_HOLDING=1
